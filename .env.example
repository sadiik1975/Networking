# Copy to .env (never commit .env).

# Database. SQLite is fine locally. On Render's free plan the file is wiped on
# redeploy, so for lasting data use a free Postgres (e.g. Neon or Supabase) URL:
#   postgresql+psycopg2://user:password@host/dbname
DATABASE_URL=sqlite:///./networking.db

# Key for the REST API (send as X-API-Key). Use a long random value in production.
API_KEY=change-me

# Key for the hosted MCP endpoint /mcp/sse (send as "Authorization: Bearer <key>").
# If unset, /mcp returns 503.
MCP_API_KEY=change-me-too

# Tavily web search for event discovery (https://tavily.com).
# TAVILY_API_KEY=

# Optional Telegram reminders and reports.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Websites used in follow-up drafts.
# BOROUGH_BUILD_URL=https://boroughbuild.netlify.app/
# BEEN_VENTURES_URL=https://been-ventures.onrender.com/
