# Copy to .env (never commit .env). No secret is required for HVAC search.

# Database (default: sqlite:///./leads.db)
DATABASE_URL=sqlite:///./leads.db

# Key required for mutating dispatch routes. Set a strong value in production.
DISPATCH_API_KEY=change-me

# Secret required to call the hosted MCP endpoint (/mcp/sse). Without it /mcp returns 503.
# Send as "Authorization: Bearer <key>" or "X-API-Key: <key>".
MCP_API_KEY=change-me-too

# Public OpenStreetMap Overpass endpoint. No API key is needed; this is not a secret.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=60
OVERPASS_MAX_RETRIES=2
OVERPASS_CACHE_TTL_SECONDS=900
# Identify your deployment to OSM services (required by their usage policies).
OSM_USER_AGENT=muse-contractor-leads/1.0 (https://been-ventures.onrender.com)

# Optional free geocoding (OSM Nominatim, max ~1 request/second) for locations
# beyond the built-in ZIP/city table.
NOMINATIM_ENABLED=false

# Tavily web search for networking event discovery (https://tavily.com).
# TAVILY_API_KEY=

# Optional: send Muse-generated reports to Telegram via the MCP tool.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
